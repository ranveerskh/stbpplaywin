rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validMeta() {
      return !request.resource.data.keys().hasAny(['meta'])
        || (
          request.resource.data.meta is map
          && request.resource.data.meta.keys().hasOnly([
            'player',
            'errorType',
            'screen',
            'reason',
            'durationSec',
            'success',
            'fromVersion',
            'toVersion',
            'statusCode'
          ])
        );
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /installations/{uid} {
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll([
          'uid',
          'version',
          'platform',
          'firstSeenAt',
          'lastSeenAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'version',
          'platform',
          'firstSeenAt',
          'lastSeenAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 20
        && request.resource.data.platform in ['win32', 'darwin', 'linux']
        && request.resource.data.firstSeenAt == request.time
        && request.resource.data.lastSeenAt == request.time;

      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.firstSeenAt == resource.data.firstSeenAt
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 20
        && request.resource.data.platform in ['win32', 'darwin', 'linux']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'version',
          'platform',
          'lastSeenAt'
        ])
        && request.resource.data.lastSeenAt == request.time;

      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'version',
          'platform',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'version',
          'platform',
          'createdAt',
          'meta'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name in [
          'app_opened',
          'first_run',
          'heartbeat',
          'portal_load_success',
          'portal_load_failed',
          'playback_started',
          'playback_failed',
          'vlc_fallback',
          'update_available',
          'update_downloaded',
          'update_installed',
          'crash_reported',
          'feature_used'
        ]
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 20
        && request.resource.data.platform in ['win32', 'darwin', 'linux']
        && request.resource.data.createdAt == request.time
        && validMeta();

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
